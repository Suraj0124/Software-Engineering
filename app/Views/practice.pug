    .rhythm-ctrl-row { display: flex; gap: 0.8rem; }
    .rhythm-btn-start { flex: 1; background: linear-gradient(135deg, #2d6a4f, #1b4332); color: white; border: none; padding: 0.9rem; border-radius: 12px; font-size: 1rem; font-weight: 700; cursor: pointer; }
    .rhythm-btn-stop { flex: 1; background: linear-gradient(135deg, #e63946, #c1121f); color: white; border: none; padding: 0.9rem; border-radius: 12px; font-size: 1rem; font-weight: 700; cursor: pointer; }
