extends layout

block content
  .practice-container
    .practice-header
      h1 🎸 Practice Tools
      p Use our interactive tools to perfect your guitar playing

    //- ── PROGRESS INDICATOR ──
    .progress-indicator
      .progress-indicator-title 🏆 Your Progress
      .progress-tools-grid
        .progress-tool-item#prog-ind-metronome
          span.progress-tool-icon 🥁
          span.progress-tool-name Metronome
        .progress-tool-item#prog-ind-pitch
          span.progress-tool-icon 🎤
          span.progress-tool-name Pitch Detect
        .progress-tool-item#prog-ind-tuner
          span.progress-tool-icon 🎵
          span.progress-tool-name Tuner
        .progress-tool-item#prog-ind-tuning
          span.progress-tool-icon 🎛️
          span.progress-tool-name Tuning Check
        .progress-tool-item#prog-ind-chords
          span.progress-tool-icon 🎸
          span.progress-tool-name Chords
        .progress-tool-item#prog-ind-quiz
          span.progress-tool-icon 📚
          span.progress-tool-name String Quiz
        .progress-tool-item#prog-ind-scale
          span.progress-tool-icon 🎵
          span.progress-tool-name Scale
        .progress-tool-item#prog-ind-progression
          span.progress-tool-icon 🎶
          span.progress-tool-name Progression
        .progress-tool-item#prog-ind-rhythm
          span.progress-tool-icon 🥁
          span.progress-tool-name Rhythm
        .progress-tool-item#prog-ind-fretboard
          span.progress-tool-icon 🎮
          span.progress-tool-name String Game
        .progress-tool-item#prog-ind-strum
          span.progress-tool-icon 🎤
          span.progress-tool-name Chord Recog
      .progress-bar-outer
        .progress-bar-inner#progress-bar-inner
        span.progress-bar-label#progress-bar-label 0 / 11 tools tried

    //- ── TAB NAVIGATION (sticky) ──
    .practice-tabs-wrapper
      .practice-tabs
        button.tab-btn.active(onclick="switchTab('tools', this)") 🎵 Tools
        button.tab-btn(onclick="switchTab('beginner', this)") 🌱 Beginner
        button.tab-btn(onclick="switchTab('intermediate', this)") 🎸 Intermediate
        button.tab-btn(onclick="switchTab('advanced', this)") 🔥 Advanced

    //- ── TAB: TOOLS ──
    .tab-content#tab-tools

      .tools-grid

        //- ── METRONOME ──
        .tool-card
          .tool-header
            span.tool-icon 🥁
            h2 Metronome
          .tool-body
            .bpm-display
              span#bpm-value 80
              span.bpm-label BPM
            .control-group
              label Tempo
              input#bpm-slider(type="range" min="40" max="220" value="80")
              .range-labels
                span 40
                span 220
            .control-group
              label Volume
              input#metro-volume(type="range" min="0" max="100" value="80")
              span#metro-vol-label 80%
            .beat-dots
              .dot#dot1
              .dot#dot2
              .dot#dot3
              .dot#dot4
            button#metro-btn.start-btn ▶ Start
          .tool-footer
            p Adjust BPM and volume, then press Start

        //- ── LIVE PITCH DETECTOR ──
        .tool-card
          .tool-header
            span.tool-icon 🎤
            h2 Live Note Detector
          .tool-body
            .pitch-display
              .pitch-note#pitch-note --
              .pitch-cents#pitch-cents Play a string...
            .pitch-indicator
              .pitch-bar
                .pitch-needle#pitch-needle
              .pitch-labels
                span Flat ♭
                span In Tune ✓
                span Sharp ♯
            .pitch-status#pitch-status 🎤 Press Start to detect your note
            button#pitch-btn.start-btn 🎤 Start Listening
          .tool-footer
            p Play any string on your guitar and we will detect the note!

        //- ── GUITAR TUNER ──
        .tool-card
          .tool-header
            span.tool-icon 🎵
            h2 Guitar Tuner
          .tool-body
            p.tuner-hint Click a string to hear the reference note
            .strings-grid
              each string in [{note:'E2',label:'6th - Low E'},{note:'A2',label:'5th - A'},{note:'D3',label:'4th - D'},{note:'G3',label:'3rd - G'},{note:'B3',label:'2nd - B'},{note:'E4',label:'1st - High E'}]
                button.string-btn(data-note=string.note)
                  span.string-note= string.note.replace('2','').replace('3','').replace('4','')
                  span.string-label= string.label
            .control-group
              label Volume
              input#tuner-volume(type="range" min="0" max="100" value="80")
              span#tuner-vol-label 80%
          .tool-footer
            p Play each string on your guitar and match the sound

      //- ── TUNING MAINTENANCE ──
      .tuning-section
        .tuning-header
          h2 🎛️ Tuning Maintenance
          p Play each string and see if it is in tune — green means perfect!
        .tuning-container
          .tuning-status-bar
            .tuning-overall#tuning-overall 🎸 Press Start to check your tuning
          .tuning-strings-list
            each s in [{id:'ts0',name:'High E',num:'1st',freq:329.63},{id:'ts1',name:'B',num:'2nd',freq:246.94},{id:'ts2',name:'G',num:'3rd',freq:196.00},{id:'ts3',name:'D',num:'4th',freq:146.83},{id:'ts4',name:'A',num:'5th',freq:110.00},{id:'ts5',name:'Low E',num:'6th',freq:82.41}]
              .tuning-string-row
                .tuning-string-info
                  span.tuning-string-num= s.num
                  span.tuning-string-name= s.name
                  span.tuning-string-freq= s.freq + ' Hz'
                .tuning-bar-container
                  .tuning-bar
                    .tuning-bar-fill(id=s.id + '-fill')
                    .tuning-center-line
                  .tuning-bar-labels
                    span ♭ Flat
                    span ✓ In Tune
                    span ♯ Sharp
                .tuning-status-icon(id=s.id + '-status') —
          .tuning-controls
            button#tuning-start-btn.tuning-start-btn 🎤 Start Tuning Check
            button#tuning-stop-btn.tuning-stop-btn(style="display:none") ⏹ Stop
            .tuning-mic-info#tuning-mic-info Play each string one at a time

    //- ── TAB: BEGINNER ──
    .tab-content#tab-beginner(style="display:none")

      .level-banner.beginner-banner
        span.level-icon 🌱
        .level-info
          h2 Beginner Practice
          p Start your guitar journey — learn chords, strings and basic theory

