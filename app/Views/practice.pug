    .inter-hero-title { font-size: 2rem; font-weight: 900; color: white; margin: 0 0 0.3rem; }
    .inter-hero-sub { color: rgba(255,255,255,0.5); font-size: 0.9rem; margin: 0; }
    .inter-hero-right { display: flex; gap: 1.5rem; }
