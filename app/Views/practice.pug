    .tuning-status-bar { text-align: center; margin-bottom: 1.5rem; font-size: 1rem; font-weight: 700; color: #1a1a2e; padding: 0.75rem; background: #f0faf5; border-radius: 10px; border: 1px solid #c8e6c9; }
