    .quiz-hud-card.quiz-hud-streak .quiz-hud-lbl { color: #f4a261; }
    /* Stage */
    .quiz-stage { display: grid; grid-template-columns: 1fr 1fr; gap: 0; min-height: 260px; }
    .quiz-stage-left { padding: 1.5rem 1rem 1.5rem 2rem; display: flex; flex-direction: column; justify-content: center; border-right: 1px solid rgba(45,106,79,0.2); }
    .quiz-stage-right { padding: 1.5rem 2rem 1.5rem 1.5rem; display: flex; align-items: center; }
    .quiz-question-label { font-size: 0.8rem; color: #52b788; font-weight: 700; text-transform: uppercase; letter-spacing: 2px; margin-bottom: 0.8rem; }
    .quiz-string-visual { background: rgba(0,0,0,0.3); border-radius: 14px; padding: 0.5rem; border: 1px solid rgba(82,183,136,0.15); margin-bottom: 0.8rem; }
    #quiz-canvas { display: block; width: 100%; border-radius: 10px; }
    .quiz-string-hint { font-size: 0.78rem; color: rgba(255,255,255,0.4); font-style: italic; }
    /* Options */
    .quiz-options-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 0.7rem; width: 100%; }
    .quiz-opt-btn { background: rgba(255,255,255,0.06); border: 2px solid rgba(255,255,255,0.1); border-radius: 14px; padding: 1rem 0.8rem; font-size: 1rem; font-weight: 800; cursor: pointer; transition: all 0.15s; color: white; text-align: center; letter-spacing: 0.3px; position: relative; overflow: hidden; }
    .quiz-opt-btn::before { content: ''; position: absolute; inset: 0; background: linear-gradient(135deg, rgba(255,255,255,0.05), transparent); }
    .quiz-opt-btn:hover:not(:disabled) { background: rgba(82,183,136,0.2); border-color: #52b788; transform: translateY(-2px); box-shadow: 0 6px 20px rgba(82,183,136,0.2); color: #52b788; }
    .quiz-opt-btn.correct { background: linear-gradient(135deg, #2d6a4f, #1b4332) !important; border-color: #52b788 !important; color: white !important; box-shadow: 0 0 30px rgba(82,183,136,0.4); animation: correctPop 0.3s ease; }
    .quiz-opt-btn.wrong { background: linear-gradient(135deg, #c1121f, #7a0d15) !important; border-color: #e63946 !important; color: white !important; animation: wrongShake 0.3s ease; }
    .quiz-opt-btn:disabled { cursor: default; }
    @keyframes correctPop { 0% { transform: scale(1); } 50% { transform: scale(1.06); } 100% { transform: scale(1); } }
    @keyframes wrongShake { 0%,100% { transform: translateX(0); } 25% { transform: translateX(-6px); } 75% { transform: translateX(6px); } }
    /* Feedback bar */
    .quiz-feedback-bar { text-align: center; padding: 0.9rem 2rem; font-size: 1rem; font-weight: 700; min-height: 48px; border-top: 1px solid rgba(45,106,79,0.2); transition: all 0.3s; display: flex; align-items: center; justify-content: center; gap: 0.5rem; }
    .quiz-feedback-bar.fb-correct { background: rgba(45,106,79,0.2); color: #52b788; }
    .quiz-feedback-bar.fb-wrong { background: rgba(198,28,35,0.15); color: #e63946; }
    .quiz-feedback-bar.fb-idle { color: rgba(255,255,255,0.3); }
    /* Start */
    .quiz-start-wrap { padding: 1.2rem 2rem 1.8rem; }
    .quiz-arcade-start { width: 100%; background: linear-gradient(135deg, #2d6a4f, #1b4332); color: white; border: none; padding: 1rem; border-radius: 14px; font-size: 1.05rem; font-weight: 800; cursor: pointer; transition: all 0.2s; letter-spacing: 0.3px; box-shadow: 0 4px 20px rgba(45,106,79,0.4); }
    .quiz-arcade-start:hover { transform: translateY(-2px); box-shadow: 0 8px 30px rgba(45,106,79,0.5); }

    /* ── OTHER SECTIONS ── */
    .progression-section, .scale-section, .rhythm-section, .strum-section { margin-top: 2rem; }
    .progression-header, .scale-header, .rhythm-header, .strum-header { text-align: center; margin-bottom: 1.5rem; padding: 1.5rem; background: linear-gradient(135deg, #1a1a2e, #16213e); border-radius: 16px; border: 1px solid #2d6a4f; }
    .progression-header h2, .scale-header h2, .rhythm-header h2, .strum-header h2 { font-size: 1.8rem; color: white; font-weight: 800; margin-bottom: 0.3rem; }
    .progression-header p, .scale-header p, .rhythm-header p, .strum-header p { color: #52b788; font-size: 0.95rem; }
    .rhythm-score-bar { display: flex; justify-content: center; gap: 1.5rem; margin-bottom: 1.5rem; flex-wrap: wrap; }
    .rhythm-stat { text-align: center; background: linear-gradient(135deg, #1a1a2e, #16213e); padding: 0.7rem 1.5rem; border-radius: 12px; border: 1px solid #2d6a4f; }
    .rhythm-stat-label { display: block; font-size: 0.65rem; color: #52b788; font-weight: 700; text-transform: uppercase; letter-spacing: 1px; }
    .rhythm-stat-value { display: block; font-size: 1.6rem; font-weight: 900; color: white; }
    .progression-container, .scale-container, .rhythm-container, .strum-container { background: white; border-radius: 20px; padding: 2rem; box-shadow: 0 8px 30px rgba(0,0,0,0.08); border: 1px solid #e8f5e9; }
    .prog-controls { display: flex; gap: 1.5rem; margin-bottom: 1.5rem; flex-wrap: wrap; }
    .prog-control-group { display: flex; flex-direction: column; gap: 0.4rem; flex: 1; }
    .prog-control-group label { font-size: 0.8rem; font-weight: 700; color: #1a1a2e; text-transform: uppercase; letter-spacing: 0.5px; }
    .prog-control-group select { padding: 0.5rem; border-radius: 8px; border: 2px solid #e8f5e9; font-size: 0.9rem; color: #1a1a2e; cursor: pointer; }
    #prog-bpm { accent-color: #2d6a4f; }
    #prog-bpm-label { font-size: 0.85rem; color: #2d6a4f; font-weight: 700; }
    .prog-display { display: grid; grid-template-columns: 1fr 1fr; gap: 1rem; margin-bottom: 1.5rem; }
    .prog-current { background: linear-gradient(135deg, #1a1a2e, #16213e); border-radius: 16px; padding: 1.5rem; text-align: center; border: 2px solid #2d6a4f; }
    .prog-next { background: #f8f9fa; border-radius: 16px; padding: 1.5rem; text-align: center; border: 2px solid #e8f5e9; }
    .prog-label { display: block; font-size: 0.65rem; font-weight: 700; letter-spacing: 2px; margin-bottom: 0.5rem; }
    .prog-current .prog-label { color: #52b788; }
    .prog-next .prog-label { color: #888; }
    .prog-chord { display: block; font-size: 3.5rem; font-weight: 900; color: white; font-family: monospace; }
    .prog-chord-next { display: block; font-size: 2.5rem; font-weight: 900; color: #888; font-family: monospace; }
    .prog-beats { display: flex; justify-content: center; gap: 1rem; margin-bottom: 1rem; }
    .prog-beat { width: 32px; height: 32px; border-radius: 50%; background: #e8f5e9; border: 2px solid #c8e6c9; transition: all 0.05s; }
    .prog-beat.active { background: #2d6a4f; border-color: #2d6a4f; box-shadow: 0 0 16px rgba(45,106,79,0.6); transform: scale(1.3); }
    .prog-progress-bar { height: 8px; background: #e8f5e9; border-radius: 4px; overflow: hidden; margin-bottom: 1rem; }
    .prog-progress-fill { height: 100%; width: 0%; background: linear-gradient(to right, #2d6a4f, #52b788); border-radius: 4px; }
    .prog-start-btn, .prog-stop-btn { display: inline-block; padding: 0.85rem 2rem; border-radius: 12px; font-size: 1rem; font-weight: 700; cursor: pointer; border: none; transition: all 0.2s; margin-right: 0.5rem; }
    .prog-start-btn { background: linear-gradient(135deg, #2d6a4f, #1b4332); color: white; }
    .prog-stop-btn { background: linear-gradient(135deg, #e63946, #c1121f); color: white; }
    .scale-controls { display: flex; gap: 1rem; margin-bottom: 1.5rem; flex-wrap: wrap; align-items: center; }
    .scale-controls select { padding: 0.6rem 1rem; border-radius: 8px; border: 2px solid #e8f5e9; font-size: 0.9rem; color: #1a1a2e; cursor: pointer; flex: 1; }
    .scale-start-btn, .scale-stop-btn { padding: 0.7rem 1.5rem; border-radius: 10px; border: none; font-size: 0.95rem; font-weight: 700; cursor: pointer; transition: all 0.2s; }
    .scale-start-btn { background: linear-gradient(135deg, #2d6a4f, #1b4332); color: white; }
    .scale-stop-btn { background: linear-gradient(135deg, #e63946, #c1121f); color: white; }
    .scale-display { text-align: center; margin-bottom: 1.5rem; }
    .scale-note-display { background: linear-gradient(135deg, #1a1a2e, #16213e); border-radius: 16px; padding: 1.5rem; border: 2px solid #2d6a4f; margin-bottom: 1rem; }
    .scale-current-note { font-size: 4rem; font-weight: 900; color: #52b788; font-family: monospace; }
    .scale-note-label { font-size: 0.9rem; color: #a0aec0; margin-top: 0.3rem; }
    .scale-notes-row { display: flex; gap: 0.5rem; justify-content: center; flex-wrap: wrap; }
    .scale-note-pill { padding: 0.4rem 0.8rem; border-radius: 20px; font-size: 0.85rem; font-weight: 700; background: #f0faf5; color: #2d6a4f; border: 2px solid #c8e6c9; transition: all 0.2s; }
    .scale-note-pill.active { background: #2d6a4f; color: white; border-color: #2d6a4f; transform: scale(1.1); }
    .scale-note-pill.done { background: #e8f5e9; color: #888; border-color: #e8f5e9; }
    .rhythm-pattern { display: flex; gap: 0.5rem; justify-content: center; margin-bottom: 1.5rem; flex-wrap: wrap; min-height: 60px; align-items: center; }
    .rhythm-beat-box { width: 50px; height: 50px; border-radius: 10px; border: 2px solid #e8f5e9; background: #f8f9fa; display: flex; align-items: center; justify-content: center; font-size: 1.2rem; transition: all 0.1s; }
    .rhythm-beat-box.active { background: #2d6a4f; border-color: #2d6a4f; transform: scale(1.1); color: white; }
    .rhythm-beat-box.hit { background: #52b788; border-color: #52b788; color: white; }
    .rhythm-beat-box.miss { background: #e63946; border-color: #e63946; color: white; }
    .rhythm-feedback { text-align: center; font-size: 1.2rem; font-weight: 700; min-height: 40px; margin-bottom: 1rem; color: #2d6a4f; }
    .rhythm-tap-btn { width: 100%; background: linear-gradient(135deg, #1a1a2e, #16213e); color: white; border: 2px solid #2d6a4f; padding: 1.2rem; border-radius: 12px; font-size: 1.2rem; font-weight: 700; cursor: pointer; transition: all 0.1s; margin-bottom: 1rem; }
    .rhythm-tap-btn:active { transform: scale(0.97); background: #2d6a4f; }
    .rhythm-controls { display: flex; gap: 1rem; }
    .rhythm-start-btn, .rhythm-stop-btn { flex: 1; padding: 0.85rem; border-radius: 12px; border: none; font-size: 1rem; font-weight: 700; cursor: pointer; transition: all 0.2s; }
    .rhythm-start-btn { background: linear-gradient(135deg, #2d6a4f, #1b4332); color: white; }
    .rhythm-stop-btn { background: linear-gradient(135deg, #e63946, #c1121f); color: white; }
    .strum-display { text-align: center; background: linear-gradient(135deg, #1a1a2e, #16213e); border-radius: 16px; padding: 2rem; margin-bottom: 1.5rem; border: 2px solid #2d6a4f; }
    .strum-chord-detected { font-size: 5rem; font-weight: 900; color: #52b788; font-family: monospace; line-height: 1; }
    .strum-chord-label { font-size: 0.85rem; color: #52b788; margin-top: 0.3rem; }
    .strum-freq-info { font-size: 0.8rem; color: #a0aec0; margin-top: 0.5rem; }
    .strum-history { margin-bottom: 1.5rem; }
    .strum-history h3 { font-size: 0.9rem; color: #1a1a2e; font-weight: 700; text-transform: uppercase; letter-spacing: 1px; margin-bottom: 0.8rem; }
    .strum-history-list { display: flex; gap: 0.5rem; flex-wrap: wrap; min-height: 40px; }
    .strum-no-history { color: #888; font-size: 0.85rem; }
    .strum-history-pill { background: #f0faf5; color: #2d6a4f; border: 1px solid #c8e6c9; padding: 0.3rem 0.8rem; border-radius: 20px; font-size: 0.85rem; font-weight: 700; }
    .strum-start-btn, .strum-stop-btn { display: inline-block; padding: 0.85rem 2rem; border-radius: 12px; font-size: 1rem; font-weight: 700; cursor: pointer; border: none; transition: all 0.2s; margin-right: 0.5rem; }
    .strum-start-btn { background: linear-gradient(135deg, #2d6a4f, #1b4332); color: white; }
    .strum-stop-btn { background: linear-gradient(135deg, #e63946, #c1121f); color: white; }

  script.
    // ── PROGRESS TRACKER ──
    const TOTAL_TOOLS = 11;
    const toolsTriedKey = 'hami_tools_tried';
    let toolsTried = JSON.parse(localStorage.getItem(toolsTriedKey) || '[]');
    function markToolTried(toolId) {
      if (!toolsTried.includes(toolId)) {
        toolsTried.push(toolId);
        localStorage.setItem(toolsTriedKey, JSON.stringify(toolsTried));
        updateProgressUI();
      }
    }
    function updateProgressUI() {
      toolsTried.forEach(id => {
        const el = document.getElementById('prog-ind-' + id);
        if (el) el.classList.add('tried');
      });
      const count = toolsTried.length;
      const bar = document.getElementById('progress-bar-inner');
      const label = document.getElementById('progress-bar-label');
      if (bar) bar.style.width = Math.round((count / TOTAL_TOOLS) * 100) + '%';
      if (label) label.textContent = count + ' / ' + TOTAL_TOOLS + ' tools tried';
    }
    updateProgressUI();

    // ── TAB SWITCHING (updated) ──
    function switchTab(tab, btn) {
      document.querySelectorAll('.tab-content').forEach(t => t.style.display = 'none');
      document.querySelectorAll('.tab-btn').forEach(b => b.classList.remove('active'));
      document.getElementById('tab-' + tab).style.display = 'block';
      if (btn) btn.classList.add('active');
      else { document.querySelectorAll('.tab-btn').forEach(b => { if (b.getAttribute('onclick') && b.getAttribute('onclick').includes("'" + tab + "'")) b.classList.add('active'); }); }
      if (tab === 'intermediate') {
        setTimeout(() => { resizeCanvas(); drawFretboard(); drawHitZone(); }, 100);
      }
    }

    // ── LEADERBOARD (localStorage) ──
    const LEADERBOARD_KEY = 'hami_quiz_leaderboard';
    function getLeaderboard() { return JSON.parse(localStorage.getItem(LEADERBOARD_KEY) || '[]'); }
    function saveToLeaderboard(score) {
      const board = getLeaderboard();
      board.push({ score, date: new Date().toLocaleDateString() });
      board.sort((a, b) => b.score - a.score);
      const top10 = board.slice(0, 10);
      localStorage.setItem(LEADERBOARD_KEY, JSON.stringify(top10));
      renderLeaderboard();
      // Also save to DATABASE so profile page shows scores
      // Save score to database
      fetch('/quiz/save-score', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ score: score, streak: quizBest })
      }).then(r => r.json()).then(data => {
        if (!data.success) console.warn('Score save failed:', data);
      }).catch(err => console.warn('Score save error:', err));
    }
    function renderLeaderboard() {
      const board = getLeaderboard();
      const list = document.getElementById('leaderboard-list');
      if (!list) return;
      if (board.length === 0) { list.innerHTML = '<p class="leaderboard-empty">No scores yet — play the quiz!</p>'; return; }
      list.innerHTML = board.map((entry, i) => {
        const rankClass = i === 0 ? 'rank-1' : i === 1 ? 'rank-2' : i === 2 ? 'rank-3' : 'rank-other';
        const medal = i === 0 ? '🥇' : i === 1 ? '🥈' : i === 2 ? '🥉' : (i + 1);
        return '<div class="leaderboard-entry"><span class="leaderboard-rank ' + rankClass + '">' + medal + '</span><span class="leaderboard-date">' + entry.date + '</span><span class="leaderboard-score">' + entry.score + ' pts</span></div>';
      }).join('');
    }
    document.getElementById('leaderboard-clear-btn').addEventListener('click', () => {
      if (confirm('Clear all leaderboard scores?')) { localStorage.removeItem(LEADERBOARD_KEY); renderLeaderboard(); }
    });
    renderLeaderboard();

    const AudioCtx = window.AudioContext || window.webkitAudioContext;
    let audioCtx = null;
    let metroInterval = null;
    let isRunning = false;
    let currentBeat = 0;
    const bpmSlider = document.getElementById('bpm-slider');
    const bpmValue = document.getElementById('bpm-value');
    const metroVolume = document.getElementById('metro-volume');
    const metroVolLabel = document.getElementById('metro-vol-label');
    const metroBtn = document.getElementById('metro-btn');
    const dots = document.querySelectorAll('.dot');
    bpmSlider.addEventListener('input', () => { bpmValue.textContent = bpmSlider.value; if (isRunning) { stopMetro(); startMetro(); } });
    metroVolume.addEventListener('input', () => { metroVolLabel.textContent = metroVolume.value + '%'; });
    function playClick(isAccent) {
      if (!audioCtx) audioCtx = new AudioCtx();
      const osc = audioCtx.createOscillator(); const gain = audioCtx.createGain();
      osc.connect(gain); gain.connect(audioCtx.destination);
      osc.frequency.value = isAccent ? 1000 : 800;
      gain.gain.setValueAtTime((metroVolume.value / 100) * 0.6, audioCtx.currentTime);
      gain.gain.exponentialRampToValueAtTime(0.001, audioCtx.currentTime + 0.08);
      osc.start(); osc.stop(audioCtx.currentTime + 0.08);
    }
    function tick() { dots.forEach(d => d.classList.remove('active')); dots[currentBeat].classList.add('active'); playClick(currentBeat === 0); currentBeat = (currentBeat + 1) % 4; }
    function startMetro() {
      if (!audioCtx) audioCtx = new AudioCtx();
      const bpm = parseInt(bpmSlider.value); metroInterval = setInterval(tick, (60 / bpm) * 1000);
      currentBeat = 0; tick(); isRunning = true; metroBtn.textContent = '⏹ Stop'; metroBtn.classList.add('running');
      markToolTried('metronome');
    }
    function stopMetro() { clearInterval(metroInterval); isRunning = false; metroBtn.textContent = '▶ Start'; metroBtn.classList.remove('running'); dots.forEach(d => d.classList.remove('active')); }
    metroBtn.addEventListener('click', () => { isRunning ? stopMetro() : startMetro(); });

    let pitchRunning = false, pitchStream = null, pitchAnalyser = null, pitchAnimFrame = null;
    const pitchBtn = document.getElementById('pitch-btn');
    const pitchNote = document.getElementById('pitch-note');
    const pitchCents = document.getElementById('pitch-cents');
    const pitchStatus = document.getElementById('pitch-status');
    const pitchNeedle = document.getElementById('pitch-needle');
    const noteStrings = ['C','C#','D','D#','E','F','F#','G','G#','A','A#','B'];
    const guitarNotes = ['E2','A2','D3','G3','B3','E4'];
    const guitarFreqs = [82.41, 110.00, 146.83, 196.00, 246.94, 329.63];
    function frequencyToNote(freq) { return Math.round(12 * (Math.log(freq / 440) / Math.log(2))) + 69; }
    function noteToFreq(note) { return 440 * Math.pow(2, (note - 69) / 12); }
    function getNoteName(freq) { const note = frequencyToNote(freq); return noteStrings[note % 12] + Math.floor(note / 12 - 1); }
    function getCents(freq) { const note = frequencyToNote(freq); return Math.floor(1200 * Math.log(freq / noteToFreq(note)) / Math.log(2)); }
    function autoCorrelate(buf, sampleRate) {
      let size = buf.length, rms = 0;
      for (let i = 0; i < size; i++) rms += buf[i] * buf[i];
      rms = Math.sqrt(rms / size);
      if (rms < 0.05) return -1;
      let r1 = 0, r2 = size - 1;
      for (let i = 0; i < size / 2; i++) { if (Math.abs(buf[i]) < 0.2) { r1 = i; break; } }
      for (let i = 1; i < size / 2; i++) { if (Math.abs(buf[size - i]) < 0.2) { r2 = size - i; break; } }
      buf = buf.slice(r1, r2); size = buf.length;
      const c = new Float32Array(size).fill(0);
      for (let i = 0; i < size; i++) for (let j = 0; j < size - i; j++) c[i] += buf[j] * buf[j + i];
      let d = 0; while (c[d] > c[d + 1]) d++;
      let maxVal = -1, maxPos = -1;
      for (let i = d; i < size; i++) { if (c[i] > maxVal) { maxVal = c[i]; maxPos = i; } }
      let T0 = maxPos;
      const x1 = c[T0-1], x2 = c[T0], x3 = c[T0+1];
      const a = (x1 + x3 - 2*x2) / 2, b = (x3 - x1) / 2;
      if (a) T0 = T0 - b / (2*a);
      return sampleRate / T0;
    }
    function detectPitch() {
      if (!pitchRunning) return;
      const buf = new Float32Array(pitchAnalyser.fftSize);
      pitchAnalyser.getFloatTimeDomainData(buf);
      const freq = autoCorrelate(buf, audioCtx.sampleRate);
      if (freq > 60 && freq < 1200) {
        const note = getNoteName(freq); const cents = getCents(freq);
        pitchNote.textContent = note;
        pitchCents.textContent = cents === 0 ? '✅ In Tune!' : cents > 0 ? '+' + cents + ' cents sharp' : cents + ' cents flat';
        let closest = 0, minDiff = Math.abs(freq - guitarFreqs[0]);
        for (let i = 1; i < guitarFreqs.length; i++) { const diff = Math.abs(freq - guitarFreqs[i]); if (diff < minDiff) { minDiff = diff; closest = i; } }
        pitchStatus.textContent = '🎸 Closest string: ' + guitarNotes[closest] + ' — ' + freq.toFixed(1) + ' Hz';
        pitchNeedle.style.left = Math.min(Math.max(50 + cents * 0.5, 5), 95) + '%';
      } else { pitchNote.textContent = '--'; pitchCents.textContent = 'Play a string...'; pitchNeedle.style.left = '50%'; }
      pitchAnimFrame = requestAnimationFrame(detectPitch);
    }
    pitchBtn.addEventListener('click', async () => {
      if (pitchRunning) {
        pitchRunning = false; cancelAnimationFrame(pitchAnimFrame);
        if (pitchStream) pitchStream.getTracks().forEach(t => t.stop());
        pitchBtn.textContent = '🎤 Start Listening'; pitchBtn.classList.remove('running');
        pitchNote.textContent = '--'; pitchCents.textContent = 'Play a string...';
        pitchStatus.textContent = '🎤 Press Start to detect your note'; pitchNeedle.style.left = '50%';
      } else {
        try {
          if (!audioCtx) audioCtx = new AudioCtx();
          pitchStream = await navigator.mediaDevices.getUserMedia({ audio: true });
          const source = audioCtx.createMediaStreamSource(pitchStream);
          pitchAnalyser = audioCtx.createAnalyser(); pitchAnalyser.fftSize = 2048;
          source.connect(pitchAnalyser); pitchRunning = true;
          pitchBtn.textContent = '⏹ Stop Listening'; pitchBtn.classList.add('running');
          pitchStatus.textContent = '🎤 Listening... play a string!';
          markToolTried('pitch');
          detectPitch();
        } catch(e) { pitchStatus.textContent = '❌ Microphone access denied!'; }
      }
    });

    // ── TUNING MAINTENANCE ──
    const tuningStrings = [
