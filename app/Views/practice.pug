    /* Chord Progression */
    .prog-arcade { padding: 1.5rem 1.8rem 1.8rem; }
    .prog-top-bar { display: flex; gap: 2rem; align-items: flex-end; margin-bottom: 1.5rem; flex-wrap: wrap; }
