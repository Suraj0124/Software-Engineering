    .rhythm-feedback { text-align: center; font-size: 1.1rem; font-weight: 800; min-height: 36px; margin-bottom: 1rem; color: rgba(255,255,255,0.5); }
    .rhythm-tap-arcade { width: 100%; background: rgba(255,255,255,0.06); color: white; border: 2px solid rgba(82,183,136,0.4); padding: 1.4rem; border-radius: 16px; font-size: 1.4rem; font-weight: 900; cursor: pointer; transition: all 0.08s; margin-bottom: 0.5rem; letter-spacing: 1px; }
