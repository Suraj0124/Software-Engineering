    .prog-select-styled { width: 100%; background: rgba(255,255,255,0.08); border: 1px solid rgba(82,183,136,0.3); border-radius: 10px; padding: 0.6rem 1rem; color: white; font-size: 0.95rem; font-weight: 600; cursor: pointer; }
    .prog-stage { display: grid; grid-template-columns: 1fr auto 1fr; align-items: center; gap: 1rem; background: rgba(0,0,0,0.3); border-radius: 16px; padding: 1.5rem; margin-bottom: 1.5rem; border: 1px solid rgba(82,183,136,0.1); }
