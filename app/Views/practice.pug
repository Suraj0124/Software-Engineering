    .prog-beat-cell { width: 52px; height: 52px; border-radius: 12px; background: rgba(255,255,255,0.05); border: 2px solid rgba(255,255,255,0.1); display: flex; align-items: center; justify-content: center; transition: all 0.06s; }
    .prog-beat-inner { font-size: 1rem; font-weight: 800; color: rgba(255,255,255,0.25); }
