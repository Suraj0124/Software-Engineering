    .prog-progress-fill2 { height: 100%; width: 0%; background: linear-gradient(to right, #2d6a4f, #52b788); border-radius: 3px; transition: width 0.1s; }
    .prog-btn-row { display: flex; gap: 0.8rem; }
    .prog-btn-start { background: linear-gradient(135deg, #2d6a4f, #1b4332); color: white; border: none; padding: 0.9rem 2rem; border-radius: 12px; font-size: 1rem; font-weight: 700; cursor: pointer; transition: all 0.2s; box-shadow: 0 4px 15px rgba(45,106,79,0.4); }
