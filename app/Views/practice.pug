              line(x1="10" y1="80" x2="90" y2="80" stroke="var(--chord-line)" stroke-width="1")
              line(x1="10" y1="100" x2="90" y2="100" stroke="var(--chord-line)" stroke-width="1")
              line(x1="10" y1="20" x2="10" y2="100" stroke="var(--chord-line)" stroke-width="1")
              line(x1="26" y1="20" x2="26" y2="100" stroke="var(--chord-line)" stroke-width="1")
              line(x1="42" y1="20" x2="42" y2="100" stroke="var(--chord-line)" stroke-width="1")
              line(x1="58" y1="20" x2="58" y2="100" stroke="var(--chord-line)" stroke-width="1")
              line(x1="74" y1="20" x2="74" y2="100" stroke="var(--chord-line)" stroke-width="1")
              line(x1="90" y1="20" x2="90" y2="100" stroke="var(--chord-line)" stroke-width="1")
              rect(x="3" y="33" width="94" height="14" rx="7" fill="#c1121f" opacity="0.85")
              circle(cx="42" cy="70" r="7" fill="#c1121f")
              circle(cx="58" cy="50" r="7" fill="#c1121f")
              circle(cx="74" cy="70" r="7" fill="#c1121f")
              text(x="5" y="115" font-size="8" fill="var(--chord-text)") 2-4-4-2-2-2
            .chord-label F# Minor

      //- ── STRING NAMING QUIZ (redesigned) ──
      .quiz-section
        .quiz-arcade-wrap
          //- Header
          .quiz-arcade-header
            .quiz-arcade-title
              span.quiz-arcade-icon 🎸
              h2 String Naming Quiz
            p.quiz-arcade-sub Identify the highlighted string as fast as you can!

          //- Score bar
          .quiz-hud
            .quiz-hud-card
              .quiz-hud-icon 🏆
              .quiz-hud-val#quiz-score 0
              .quiz-hud-lbl Score
            .quiz-hud-card.quiz-hud-streak
              .quiz-hud-icon 🔥
              .quiz-hud-val#quiz-streak 0
              .quiz-hud-lbl Streak
            .quiz-hud-card
              .quiz-hud-icon ⭐
              .quiz-hud-val#quiz-best 0
              .quiz-hud-lbl Best Streak
            .quiz-hud-card
              .quiz-hud-icon ❓
              .quiz-hud-val#quiz-qcount 0
              .quiz-hud-lbl Questions

          //- Guitar visual + question
          .quiz-stage
            .quiz-stage-left
              .quiz-question-label Which string is this?
              .quiz-string-visual
                canvas#quiz-canvas(width="320" height="160")
              .quiz-string-hint#quiz-string-hint Pick the correct string name →

            .quiz-stage-right
              .quiz-options-grid#quiz-options

          //- Feedback bar
          .quiz-feedback-bar#quiz-feedback

          //- Start button
          .quiz-start-wrap
            button#quiz-start-btn.quiz-arcade-start 🎮 Start Quiz

        //- ── LEADERBOARD ──
        .leaderboard-section
          .leaderboard-header
            h3 🏆 Quiz Leaderboard — Top Scores
            button#leaderboard-clear-btn.leaderboard-clear-btn 🗑 Clear
          .leaderboard-list#leaderboard-list
            p.leaderboard-empty No scores yet — play the quiz!

      //- ── SCALE PRACTICE ──
      .scale-section
        .scale-header
          h2 🎵 Scale Practice
          p Learn guitar scales — follow the highlighted notes!
        .scale-container
          .scale-controls
            select#scale-select
              option(value="C") C Major
              option(value="G") G Major
              option(value="Am") A Minor
              option(value="Em") E Minor
            select#scale-speed
              option(value="slow") Slow
              option(value="medium") Medium
              option(value="fast") Fast
            button#scale-start-btn.scale-start-btn 🎵 Start Scale
            button#scale-stop-btn.scale-stop-btn(style="display:none") ⏹ Stop
          .scale-display
            .scale-note-display
              .scale-current-note#scale-current-note --
              .scale-note-label#scale-note-label Press Start
          .scale-notes-row#scale-notes-row

    //- ── TAB: INTERMEDIATE ──
    .tab-content#tab-intermediate(style="display:none")

      //- Hero banner
      .inter-hero
        .inter-hero-left
          .inter-hero-badge 🎸 INTERMEDIATE
          h2.inter-hero-title Build Your Skills
          p.inter-hero-sub Chord changes · Rhythm · String challenge
        .inter-hero-right
          .inter-hero-stat
            span.inter-hero-stat-val#inter-session-score 0
            span.inter-hero-stat-lbl Session Points
          .inter-hero-stat
            span.inter-hero-stat-val#inter-tools-done 0/3
            span.inter-hero-stat-lbl Tools Used

      //- ── CHORD PROGRESSION ──
      .inter-section
        .inter-section-header
          .inter-section-icon 🎶
          .inter-section-info
            h3 Chord Progression Practice
            p Switch chords in time with the beat
          .inter-section-badge SECTION 1
        .prog-arcade
          .prog-top-bar
            .prog-top-left
              .prog-bpm-display
                span#prog-bpm-num 60
                span.prog-bpm-unit BPM
              input#prog-bpm.prog-bpm-slider(type="range" min="40" max="180" value="60")
            .prog-top-right
              label.prog-select-label 🎵 Progression
              select#prog-select.prog-select-styled
                option(value="G-C-D-Em") G → C → D → Em
                option(value="Am-F-C-G") Am → F → C → G
                option(value="E-A-D-A") E → A → D → A
                option(value="C-G-Am-F") C → G → Am → F
                option(value="D-A-Bm-G") D → A → Bm → G
          .prog-stage
            .prog-chord-now
              .prog-chord-badge NOW
              .prog-chord-big#prog-current-chord —
              .prog-chord-sub Current Chord
            .prog-divider
              .prog-arrow ▶
            .prog-chord-next-wrap
              .prog-chord-badge.next-badge NEXT
              .prog-chord-med#prog-next-chord —
              .prog-chord-sub Up Next
          .prog-beat-row
            .prog-beat-cell#pb1
              .prog-beat-inner 1
            .prog-beat-cell#pb2
              .prog-beat-inner 2
            .prog-beat-cell#pb3
              .prog-beat-inner 3
            .prog-beat-cell#pb4
              .prog-beat-inner 4
          .prog-bottom-bar
            .prog-progress-track2
              .prog-progress-fill2#prog-progress-fill
            .prog-btn-row
              button#prog-start-btn.prog-btn-start 🎵 Start Practice
              button#prog-stop-btn.prog-btn-stop(style="display:none") ⏹ Stop

      //- ── RHYTHM TAPPING GAME ──
      .inter-section
        .inter-section-header
          .inter-section-icon 🥁
          .inter-section-info
            h3 Rhythm Tapping Game
            p Tap in time with the beat pattern
          .inter-section-badge SECTION 2
        .rhythm-arcade
          .rhythm-hud
            .rhythm-hud-card
              .rhythm-hud-val#rhythm-score 0
              .rhythm-hud-lbl 🏆 Score
            .rhythm-hud-card.rh-accent
              .rhythm-hud-val#rhythm-accuracy 0%
              .rhythm-hud-lbl 🎯 Accuracy
            .rhythm-hud-card
              .rhythm-hud-val#rhythm-level 1
              .rhythm-hud-lbl ⚡ Level
            .rhythm-hud-card
              .rhythm-hud-val#rhythm-combo 0
              .rhythm-hud-lbl 🔥 Combo
          .rhythm-pattern-wrap
            .rhythm-pattern-label BEAT PATTERN
            .rhythm-pattern#rhythm-pattern
          .rhythm-feedback#rhythm-feedback
          button#rhythm-tap-btn.rhythm-tap-arcade 🥁 TAP
          p.rhythm-tap-hint Press SPACEBAR or tap the button above
          .rhythm-ctrl-row
            button#rhythm-start-btn.rhythm-btn-start 🎮 Start Game
            button#rhythm-stop-btn.rhythm-btn-stop(style="display:none") ⏹ Stop Game

      //- ── STRING CHALLENGE ──
      .inter-section
        .inter-section-header
          .inter-section-icon 🎯
          .inter-section-info
            h3 String Challenge
            p Play the string shown — mic detects your guitar!
          .inter-section-badge SECTION 3
        .fb-arcade-wrap
          .fb-arcade-hud
            .fb-hud-left
              .fb-lives-row
                span.fb-heart#heart1 ♥
                span.fb-heart#heart2 ♥
                span.fb-heart#heart3 ♥
                span.fb-heart#heart4 ♥
                span.fb-heart#heart5 ♥
              .fb-multiplier-badge
                span#fb-multiplier 1×
            .fb-hud-center
              .fb-instruction-pill#fb-instruction Press Start!
            .fb-hud-right
              .fb-score-display
                .fb-score-lbl SCORE
                .fb-score-big#fb-score 0
          canvas#fretboard-canvas.fb-canvas-full
          .fb-arcade-bottom
            button#fb-pause-btn.fb-ctrl-btn ⏸
            .fb-prog-track
              .fb-prog-fill#fb-progress-fill
            button#fb-hand-btn.fb-ctrl-btn 🖐
        .fb-arcade-controls
          .fb-ctrl-left
            button#fb-start-btn.fb-btn-start 🎸 Start Game
            button#fb-stop-btn.fb-btn-stop(style="display:none") ⏹ Stop
          .fb-mic-badge#fb-mic-status 🎤 Mic not active

        //- ── MIC DETECTION PANEL ──
        .fb-detect-panel
          .fb-detect-left
            .fb-detect-label 🎤 MICROPHONE HEARING
            .fb-detect-freq#fb-detect-freq — Hz
            .fb-detect-note#fb-detect-note Waiting...
          .fb-detect-right
            .fb-detect-strings
              .fb-detect-string-pill(data-string="1" style="border-color:#e63946")
                .fb-detect-pill-num(style="background:#e63946") 1
                span E
              .fb-detect-string-pill(data-string="2" style="border-color:#f4a261")
                .fb-detect-pill-num(style="background:#f4a261") 2
                span B
              .fb-detect-string-pill(data-string="3" style="border-color:#52b788")
                .fb-detect-pill-num(style="background:#52b788") 3
                span G
              .fb-detect-string-pill(data-string="4" style="border-color:#4cc9f0")
                .fb-detect-pill-num(style="background:#4cc9f0") 4
                span D
              .fb-detect-string-pill(data-string="5" style="border-color:#a78bfa")
                .fb-detect-pill-num(style="background:#a78bfa") 5
                span A
              .fb-detect-string-pill(data-string="6" style="border-color:#ffd166")
                .fb-detect-pill-num(style="background:#ffd166") 6
                span E
        .fb-guide-grid
          each s in [{n:"1",name:"E",note:"High E",freq:"330 Hz",color:"#e63946"},{n:"2",name:"B",note:"B",freq:"247 Hz",color:"#f4a261"},{n:"3",name:"G",note:"G",freq:"196 Hz",color:"#52b788"},{n:"4",name:"D",note:"D",freq:"147 Hz",color:"#4cc9f0"},{n:"5",name:"A",note:"A",freq:"110 Hz",color:"#a78bfa"},{n:"6",name:"E",note:"Low E",freq:"82 Hz",color:"#ffd166"}]
            .fb-guide-card(style="border-left: 3px solid " + s.color)
              .fb-guide-num(style="background:" + s.color)= s.n
              .fb-guide-info
                .fb-guide-name(style="color:" + s.color)= s.name
                .fb-guide-note= s.note + " — " + s.freq

    //- ── TAB: ADVANCED ──
    .tab-content#tab-advanced(style="display:none")

      .level-banner.advanced-banner
        span.level-icon 🔥
        .level-info
          h2 Advanced Practice
          p Master your guitar — real-time detection and chord recognition

      //- ── FREE STRUM MODE ──
      .strum-section
        .strum-header
          h2 🎤 Free Strum — Chord Recogniser
          p Strum your guitar and we will try to identify the chord!
        .strum-container
          .strum-display
            .strum-chord-detected#strum-chord --
            .strum-chord-label Detected Chord
            .strum-freq-info#strum-freq-info Play your guitar...
          .strum-history
            h3 Recent Chords
            .strum-history-list#strum-history-list
              p.strum-no-history No chords detected yet
          button#strum-start-btn.strum-start-btn 🎤 Start Listening
          button#strum-stop-btn.strum-stop-btn(style="display:none") ⏹ Stop

  style.
    * { box-sizing: border-box; }

    /* ── DARK MODE CHORD DIAGRAM VARS ── */
    :root {
      --chord-nut: #333;
      --chord-line: #555;
      --chord-text: #666;
      --chord-muted: #999;
      --chord-bg: #ffffff;
      --chord-name-color: #1a1a2e;
    }
    @media (prefers-color-scheme: dark) {
      :root {
        --chord-nut: #aaa;
        --chord-line: #888;
        --chord-text: #ccc;
        --chord-muted: #aaa;
        --chord-bg: #1e2a3a;
        --chord-name-color: #ffffff;
      }
    }

    .practice-container { max-width: 1100px; margin: 0 auto; padding: 2.5rem 2rem; }
    .practice-header { text-align: center; margin-bottom: 1.5rem; padding: 2rem; background: linear-gradient(135deg, #1a1a2e, #16213e); border-radius: 20px; border: 1px solid #2d6a4f; }
    .practice-header h1 { font-size: 2.4rem; color: #ffffff; font-weight: 800; margin-bottom: 0.5rem; }
    .practice-header p { color: #52b788; font-size: 1rem; }

    /* ── PROGRESS INDICATOR ── */
    .progress-indicator { background: white; border-radius: 16px; padding: 1.2rem 1.5rem; margin-bottom: 1.5rem; border: 1px solid #e8f5e9; box-shadow: 0 4px 15px rgba(0,0,0,0.06); }
    .progress-indicator-title { font-size: 0.85rem; font-weight: 800; color: #1a1a2e; text-transform: uppercase; letter-spacing: 1px; margin-bottom: 0.8rem; }
    .progress-tools-grid { display: flex; flex-wrap: wrap; gap: 0.5rem; margin-bottom: 0.8rem; }
    .progress-tool-item { display: flex; align-items: center; gap: 0.3rem; background: #f0faf5; border: 2px solid #e8f5e9; border-radius: 20px; padding: 0.3rem 0.7rem; font-size: 0.75rem; font-weight: 700; color: #aaa; transition: all 0.3s; }
    .progress-tool-item.tried { background: #2d6a4f; border-color: #2d6a4f; color: white; }
    .progress-tool-icon { font-size: 0.85rem; }
    .progress-bar-outer { height: 10px; background: #e8f5e9; border-radius: 5px; overflow: hidden; margin-bottom: 0.4rem; }
    .progress-bar-inner { height: 100%; width: 0%; background: linear-gradient(to right, #2d6a4f, #52b788); border-radius: 5px; transition: width 0.4s ease; }
    .progress-bar-label { font-size: 0.78rem; color: #888; font-weight: 600; }

    /* ── STICKY TABS ── */
    .practice-tabs-wrapper { position: sticky; top: 0; z-index: 100; background: white; padding: 0.5rem 0; margin-bottom: 1.5rem; border-bottom: 2px solid #e8f5e9; }
    .practice-tabs { display: flex; gap: 0.5rem; background: #f0faf5; padding: 0.5rem; border-radius: 16px; border: 1px solid #c8e6c9; flex-wrap: wrap; }
    .tab-btn { flex: 1; padding: 0.75rem 1rem; border: none; border-radius: 12px; font-size: 0.95rem; font-weight: 700; cursor: pointer; transition: all 0.2s; background: transparent; color: #2d6a4f; min-width: 120px; }
    .tab-btn:hover { background: rgba(45,106,79,0.1); }
    .tab-btn.active { background: linear-gradient(135deg, #1a1a2e, #16213e); color: white; box-shadow: 0 4px 15px rgba(0,0,0,0.2); }

    .level-banner { display: flex; align-items: center; gap: 1.5rem; padding: 1.5rem 2rem; border-radius: 16px; margin-bottom: 2rem; }
    .beginner-banner { background: linear-gradient(135deg, #1b4332, #2d6a4f); border: 1px solid #52b788; }
    .intermediate-banner { background: linear-gradient(135deg, #1a1a2e, #2c3e6e); border: 1px solid #4cc9f0; }
    .advanced-banner { background: linear-gradient(135deg, #4a1810, #c1121f); border: 1px solid #e63946; }
    .level-icon { font-size: 3rem; }
    .level-info h2 { font-size: 1.6rem; font-weight: 800; color: white; margin: 0 0 0.3rem; }
    .level-info p { color: rgba(255,255,255,0.8); font-size: 0.95rem; margin: 0; }

    .tools-grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(300px, 1fr)); gap: 1.5rem; margin-bottom: 2rem; }
    .tool-card { background: white; border-radius: 20px; box-shadow: 0 8px 30px rgba(0,0,0,0.1); overflow: hidden; border: 1px solid #e8f5e9; transition: transform 0.2s, box-shadow 0.2s; }
    .tool-card:hover { transform: translateY(-4px); box-shadow: 0 12px 40px rgba(45,106,79,0.15); }
    .tool-header { background: linear-gradient(135deg, #1a1a2e, #2d6a4f); padding: 1.3rem 1.5rem; display: flex; align-items: center; gap: 0.75rem; }
    .tool-icon { font-size: 1.8rem; }
    .tool-header h2 { color: white; font-size: 1.2rem; font-weight: 700; margin: 0; }
    .tool-body { padding: 1.5rem; }
    .tool-footer { background: #f0faf5; padding: 0.75rem 1.5rem; border-top: 1px solid #e8f5e9; }
    .tool-footer p { font-size: 0.82rem; color: #2d6a4f; margin: 0; font-weight: 500; }
    .bpm-display { text-align: center; background: linear-gradient(135deg, #1a1a2e, #16213e); border-radius: 16px; padding: 1.5rem; margin-bottom: 1.5rem; border: 2px solid #2d6a4f; }
    #bpm-value { font-size: 4rem; font-weight: 900; color: #52b788; }
    .bpm-label { font-size: 1rem; color: #a0aec0; margin-left: 0.5rem; font-weight: 600; }
    .control-group { margin-bottom: 1.2rem; }
    .control-group label { display: block; font-weight: 700; color: #1a1a2e; margin-bottom: 0.5rem; font-size: 0.88rem; text-transform: uppercase; letter-spacing: 0.5px; }
    input[type=range] { width: 100%; accent-color: #2d6a4f; cursor: pointer; }
    .range-labels { display: flex; justify-content: space-between; font-size: 0.75rem; color: #aaa; margin-top: 4px; }
    #metro-vol-label, #tuner-vol-label { font-size: 0.85rem; color: #2d6a4f; font-weight: 700; float: right; margin-top: -1.4rem; }
    .beat-dots { display: flex; justify-content: center; gap: 1rem; margin: 1.5rem 0; }
    .dot { width: 28px; height: 28px; border-radius: 50%; background: #e8f5e9; border: 2px solid #c8e6c9; transition: all 0.05s; }
    .dot.active { background: #e63946; border-color: #e63946; box-shadow: 0 0 16px rgba(230,57,70,0.6); transform: scale(1.3); }
    .start-btn { width: 100%; background: linear-gradient(135deg, #2d6a4f, #1b4332); color: white; border: none; padding: 0.9rem; border-radius: 12px; font-size: 1rem; font-weight: 700; cursor: pointer; transition: all 0.2s; margin-top: 0.5rem; }
    .start-btn:hover { transform: translateY(-2px); box-shadow: 0 6px 20px rgba(45,106,79,0.4); }
    .start-btn.running { background: linear-gradient(135deg, #e63946, #c1121f); }
    .pitch-display { text-align: center; background: linear-gradient(135deg, #1a1a2e, #16213e); border-radius: 16px; padding: 1.5rem; margin-bottom: 1.2rem; border: 2px solid #2d6a4f; }
    .pitch-note { font-size: 4rem; font-weight: 900; color: #52b788; line-height: 1; }
    .pitch-cents { font-size: 0.9rem; color: #a0aec0; margin-top: 0.3rem; }
    .pitch-indicator { margin-bottom: 1.2rem; }
    .pitch-bar { position: relative; height: 14px; background: linear-gradient(to right, #3498db, #2d6a4f, #e63946); border-radius: 7px; margin-bottom: 0.4rem; }
    .pitch-needle { position: absolute; top: -5px; left: 50%; transform: translateX(-50%); width: 4px; height: 24px; background: white; border-radius: 2px; box-shadow: 0 0 8px rgba(0,0,0,0.4); transition: left 0.1s; }
    .pitch-labels { display: flex; justify-content: space-between; font-size: 0.75rem; color: #888; font-weight: 600; }
    .pitch-status { text-align: center; font-size: 0.88rem; color: #2d6a4f; margin-bottom: 1rem; padding: 0.6rem; background: #f0faf5; border-radius: 10px; font-weight: 600; border: 1px solid #c8e6c9; }
    .tuner-hint { text-align: center; color: #2d6a4f; font-size: 0.88rem; margin-bottom: 1.2rem; background: #f0faf5; padding: 0.6rem; border-radius: 10px; font-weight: 600; border: 1px solid #c8e6c9; }
    .strings-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 0.6rem; margin-bottom: 1.2rem; }
    .string-btn { background: #f8f9fa; border: 2px solid #e8f5e9; border-radius: 12px; padding: 0.8rem 0.4rem; cursor: pointer; transition: all 0.15s; display: flex; flex-direction: column; align-items: center; gap: 3px; }
    .string-btn:hover { background: #1a1a2e; border-color: #1a1a2e; transform: translateY(-2px); }
    .string-btn:hover .string-note, .string-btn:hover .string-label { color: white; }
    .string-btn.playing { background: #2d6a4f; border-color: #2d6a4f; box-shadow: 0 4px 15px rgba(45,106,79,0.4); }
    .string-btn.playing .string-note, .string-btn.playing .string-label { color: white; }
    .string-note { font-size: 1.4rem; font-weight: 900; color: #1a1a2e; }
    .string-label { font-size: 0.65rem; color: #888; font-weight: 600; }

    /* ── CHORD LIBRARY (dark mode fixed) ── */
    .chord-section { margin-top: 0; }
    .chord-section-header { text-align: center; margin-bottom: 1.5rem; padding: 1.5rem; background: linear-gradient(135deg, #1a1a2e, #16213e); border-radius: 16px; border: 1px solid #2d6a4f; }
    .chord-section-header h2 { font-size: 1.8rem; color: white; font-weight: 800; margin-bottom: 0.3rem; }
    .chord-section-header p { color: #52b788; font-size: 0.95rem; }
    .chords-grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(150px, 1fr)); gap: 1rem; margin-bottom: 2rem; }
    .chord-card { background: var(--chord-bg, white); border-radius: 16px; padding: 1rem; text-align: center; box-shadow: 0 4px 15px rgba(0,0,0,0.07); border: 2px solid #e8f5e9; cursor: pointer; transition: all 0.2s; }
    .chord-card:hover { border-color: #2d6a4f; transform: translateY(-5px); box-shadow: 0 10px 30px rgba(45,106,79,0.15); }
    .chord-card.active { border-color: #2d6a4f; background: #f0faf5; }
    .chord-name { font-size: 1.8rem; font-weight: 900; color: var(--chord-name-color, #1a1a2e); margin-bottom: 0.4rem; }
