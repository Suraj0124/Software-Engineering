    .rhythm-beat-box { width: 52px; height: 52px; border-radius: 12px; border: 2px solid rgba(255,255,255,0.1); background: rgba(255,255,255,0.04); display: flex; align-items: center; justify-content: center; font-size: 1.3rem; transition: all 0.08s; }
