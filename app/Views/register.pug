extends layout

block content
  .login-page
    .login-box
      .login-header
        span.login-logo 🎸
        h1 Join Nepali Hami
        p.tagline Start your guitar learning journey today!
        .welcome-features
          span.wf 🎵 Free Lessons
          span.wf 🥁 Practice Tools
          span.wf ⭐ Track Progress
          span.wf 🎮 Note Challenge

      .divider-line

      if error
        .error-msg ⚠️ #{error}

      form(method='POST' action='/register')
        .form-group
          label Full Name
          input(type='text' name='name' placeholder='Enter your full name' required)
        .form-group
          label Email Address
          input(type='email' name='email' placeholder='Enter your email' required)
        .form-group
          label Password
          input(type='password' name='password' placeholder='Create a password' required)
        button.btn-login(type='submit') Create Account →

      p.register-link Already have an account?
        a(href='/login') Sign in here

  style.
    body { background: linear-gradient(135deg, #1a1a2e 0%, #16213e 50%, #2d6a4f 100%) !important; min-height: 100vh; }

    .login-page {
      display: flex;
      align-items: center;
      justify-content: center;
      min-height: 90vh;
      padding: 2rem;
    }

    .login-box {
      background: white;
      border-radius: 20px;
      padding: 2.5rem;
      width: 100%;
      max-width: 450px;
      box-shadow: 0 20px 60px rgba(0,0,0,0.3);
    }

    .login-header { text-align: center; margin-bottom: 1.5rem; }
    .login-logo { font-size: 3.5rem; display: block; margin-bottom: 0.5rem; }
    .login-header h1 { font-size: 1.7rem; font-weight: 800; color: #1a1a2e; margin-bottom: 0.3rem; }
    .tagline { color: #2d6a4f; font-size: 0.9rem; font-weight: 600; margin-bottom: 1rem; }

    .welcome-features {
      display: flex;
      justify-content: center;
      gap: 0.5rem;
      flex-wrap: wrap;
      margin-top: 0.75rem;
    }
    .wf {
      background: #f0faf5;
      border: 1px solid #c6e8d4;
      color: #2d6a4f;
      padding: 0.3rem 0.7rem;
      border-radius: 20px;
      font-size: 0.78rem;
      font-weight: 600;
    }

    .divider-line { height: 1px; background: #e2e8f0; margin: 1.5rem 0; }

    .form-group { margin-bottom: 1.2rem; }
    .form-group label { display: block; font-weight: 600; margin-bottom: 0.5rem; color: #333; font-size: 0.9rem; }
    .form-group input {
      width: 100%;
      padding: 0.75rem 1rem;
      border: 2px solid #e2e8f0;
      border-radius: 10px;
      font-size: 1rem;
      box-sizing: border-box;
      transition: border-color 0.2s;
    }
    .form-group input:focus { outline: none; border-color: #2d6a4f; }

    .btn-login {
      width: 100%;
      background: linear-gradient(135deg, #2d6a4f, #1b4332);
      color: white;
      border: none;
      padding: 0.85rem;
      border-radius: 10px;
      font-size: 1rem;
      font-weight: 700;
      cursor: pointer;
      transition: all 0.2s;
      margin-top: 0.5rem;
    }
    .btn-login:hover { opacity: 0.9; transform: translateY(-2px); }

    .error-msg {
      background: #fff5f5;
      border: 1px solid #fed7d7;
      color: #c53030;
      padding: 0.75rem 1rem;
      border-radius: 10px;
      margin-bottom: 1.2rem;
      font-size: 0.9rem;
    }

    .register-link { text-align: center; font-size: 0.9rem; color: #666; margin-top: 1.5rem; }
    .register-link a { color: #2d6a4f; font-weight: 600; text-decoration: none; }
    .register-link a:hover { color: #1b4332; }